# Only needed when running the API outside Docker Compose (npm run dev).
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://isp888:devpassword@localhost:5432/isp888
# development: exact built-in allowlist http://localhost:3000 + http://127.0.0.1:3000.
# CORS_ORIGIN is used in test/production only (never a comma-separated list or *).
# production: explicitly set NODE_ENV=production and one real web origin, e.g.
# CORS_ORIGIN=https://lab.example.org
CORS_ORIGIN=http://localhost:3000

# Google OAuth Web application credentials (server-only; never NEXT_PUBLIC_*).
# Leave blank until configured; local password login and public pages still work.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/auth/google/callback
