# Only needed when running the web app outside Docker Compose (npm run dev).
# Inside Compose this is set to http://api:4000.
API_BASE_URL=http://localhost:4000

# Browser-reachable tracking API origin. Development API allows both
# http://localhost:3000 and http://127.0.0.1:3000 explicitly.
# Production API CORS_ORIGIN must be the one real web origin.
# Set at build time. Never use the Compose-internal http://api:4000 here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Canonical browser origin. Must match the origin of API GOOGLE_REDIRECT_URI.
APP_BASE_URL=http://127.0.0.1:3000
